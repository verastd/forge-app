{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // tests/e2e lives at the repo root (PRD Appendix A.1) but is typechecked
      // here, where its only dependency is installed.
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../tests/e2e/**/*.ts",
    ".next-e2e-demo/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-e2e-live/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
