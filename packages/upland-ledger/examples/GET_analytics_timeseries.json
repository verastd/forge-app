  "sql": "SELECT toDateTime(toStartOfDay(hour), 'UTC') AS d0,\n       sum(count) AS m0\nFROM upland.actions_hourly\nWHERE hour >= toDateTime({p0:String}, 'UTC')\n  AND hour <= toDateTime({p1:String}, 'UTC')\nGROUP BY d0\nORDER BY d0 ASC\nLIMIT 10000"
